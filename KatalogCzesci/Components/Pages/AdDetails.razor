
@page "/ogloszenie/{Id:guid}"
@rendermode InteractiveServer

@using KatalogCzesci.Models
@using KatalogCzesci.Services
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CatalogService CatalogService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>
    @(ad?.Title ?? "Ogłoszenie")
</PageTitle>

<div class="container py-4">

    @if (ad == null)
    {
        <p>Wczytywanie...</p>
    }
    else
    {
        <!-- ================================================= -->
        <!-- POWRÓT -->
        <!-- ================================================= -->

        <button type="button"
                class="btn btn-outline-secondary mb-4"
                @onclick="GoBack">

            ← Wróć

        </button>


        <!-- ================================================= -->
        <!-- STATUS -->
        <!-- ================================================= -->
        @if (ad.Status == AdStatus.Sold)
        {
            <div class="alert alert-danger mb-4">

                <strong>
                    SPRZEDANE
                </strong>

            </div>
        }


        <!-- ================================================= -->
        <!-- ZDJĘCIA -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            @if (photoCount > 0)
            {
                <div class="position-relative bg-white"
                     style="height: 500px;">

                    <img src="@GetImagePath(ad, currentIndex)"
                         alt="@ad.Title"
                         class="w-100 h-100"
                         style="object-fit: contain; padding: 20px;" />


                    @if (photoCount > 1)
                    {
                        <!-- LEWA STRZAŁKA -->

                        <button type="button"
                                class="position-absolute top-50 start-0 translate-middle-y"
                                style="margin-left: 15px;
                                                   width: 48px;
                                                   height: 48px;
                                                   border: none;
                                                   border-radius: 6px;
                                                   background-color: #0d6efd;
                                                   color: white;
                                                   font-size: 32px;
                                                   line-height: 40px;
                                                   cursor: pointer;
                                                   box-shadow: 0 2px 6px rgba(0,0,0,0.25);"
                                @onclick="PreviousPhoto">

                            ‹

                        </button>


                        <!-- PRAWA STRZAŁKA -->

                        <button type="button"
                                class="position-absolute top-50 end-0 translate-middle-y"
                                style="margin-right: 15px;
                                                   width: 48px;
                                                   height: 48px;
                                                   border: none;
                                                   border-radius: 6px;
                                                   background-color: #0d6efd;
                                                   color: white;
                                                   font-size: 32px;
                                                   line-height: 40px;
                                                   cursor: pointer;
                                                   box-shadow: 0 2px 6px rgba(0,0,0,0.25);"
                                @onclick="NextPhoto">

                            ›

                        </button>


                        <!-- LICZNIK -->

                        <div class="position-absolute bottom-0 start-50 translate-middle-x mb-3">

                            <span class="badge bg-dark">
                                @(currentIndex + 1) / @photoCount
                            </span>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center bg-light"
                     style="height: 300px;">

                    <span class="text-muted">
                        Brak zdjęć
                    </span>

                </div>
            }

        </div>


        <!-- ================================================= -->
        <!-- INFORMACJE -->
        <!-- ================================================= -->

        <div class="card shadow-sm">

            <div class="card-body">

                <!-- TYTUŁ -->

                <h1 class="mb-3">
                    @ad.Title
                </h1>


                <!-- ŹRÓDŁO -->
                @if (ad.OlxId.HasValue)
                {
                    <span class="badge bg-primary mb-3">
                        OLX
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary mb-3">
                        LOKALNE / ADMIN
                    </span>
                }


                <!-- KATEGORIE -->
                @if (ad.Categories?.Any() == true)
                {
                    <p class="text-muted mb-3">
                        @string.Join(" / ", ad.Categories)
                    </p>
                }


                <!-- OPIS -->

                <h4>
                    Opis
                </h4>

                @if (string.IsNullOrWhiteSpace(ad.Description))
                {
                    <p class="text-muted">
                        Brak opisu.
                    </p>
                }
                else
                {
                    <div style="white-space: pre-line;">
                        @ad.Description
                    </div>
                }


                <!-- CENA -->

                <div class="mt-4">

                    <h2>
                        @ad.Price.ToString("0.00") zł
                    </h2>

                </div>


                <!-- DATA -->
                @if (ad.ActivatedAt.HasValue)
                {
                    <p class="text-muted mt-3">
                        📅 Dodano:
                        @ad.ActivatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy")
                    </p>
                }


            <!-- ID -->

            <small class="text-muted">

                ID:
                @(ad.OlxId?.ToString()
                                ?? ad.Id.ToString("N")[..8])

            </small>

            </div>


            <!-- ================================================= -->
            <!-- AKCJE -->
            <!-- ================================================= -->

            <div class="card-footer bg-white">

                <div class="d-flex gap-2 flex-wrap">

                    <!-- EDYCJA -->

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="EditAd">

                        ✏️ Edytuj

                    </button>


                    <!-- STATUS -->
                @if (ad.Status == AdStatus.Sold)
                    {
                        <button type="button"
                                class="btn btn-success"
                                @onclick="MarkAsActive">

                            ↩ Przywróć jako aktywne

                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-danger"
                                @onclick="MarkAsSold">

                            ✓ Oznacz jako sprzedane

                        </button>
                    }


                    <!-- USUWANIE - TYLKO LOKALNE -->
                    @if (!ad.OlxId.HasValue)
                    {
                        <button type="button"
                                class="btn btn-outline-danger"
                                @onclick="DeleteAd">

                            🗑 Usuń ogłoszenie

                        </button>
                    }

                </div>

            </div>

        </div>
    }

</div>


@code {

    [Parameter]
    public Guid Id { get; set; }


    private Ad? ad;

    private int currentIndex = 0;


    private int photoCount =>
        ad?.Photos?.Count ?? 0;


    // =================================================
    // SPRAWDZENIE ADMINA
    // =================================================

    private async Task<bool> RequireAdmin()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();


        var user =
            authState.User;


        if (!user.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/login");
            return false;
        }


        if (!user.IsInRole("Admin"))
        {
            Navigation.NavigateTo("/login");
            return false;
        }


        return true;
    }


    // =================================================
    // ODCZYT
    // =================================================

    protected override async Task OnInitializedAsync()
    {
        // Najpierw szukamy w ogłoszeniach OLX.

        var olxAds =
            await CatalogService.GetOlxAdsAsync();

        ad =
            olxAds.FirstOrDefault(
                x => x.Id == Id);


        // Jeśli nie znaleziono, szukamy lokalnych.

        if (ad == null)
        {
            var localAds =
                await CatalogService.GetLocalAdsAsync();

            ad =
                localAds.FirstOrDefault(
                    x => x.Id == Id);
        }


        // Nie znaleziono ogłoszenia.

        if (ad == null)
        {
            Navigation.NavigateTo("/");
        }
    }


    // =================================================
    // ŚCIEŻKA ZDJĘCIA
    // =================================================

    private string GetImagePath(
        Ad ad,
        int photoIndex)
    {
        var folderId =
            ad.OlxId?.ToString()
            ??
            ad.Id.ToString();


        return
            $"/images/{folderId}/{photoIndex + 1:00}.jpg";
    }


    // =================================================
    // NEXT
    // =================================================

    private void NextPhoto()
    {
        if (photoCount <= 1)
        {
            return;
        }


        currentIndex++;


        if (currentIndex >= photoCount)
        {
            currentIndex = 0;
        }
    }


    // =================================================
    // PREVIOUS
    // =================================================

    private void PreviousPhoto()
    {
        if (photoCount <= 1)
        {
            return;
        }


        currentIndex--;


        if (currentIndex < 0)
        {
            currentIndex =
                photoCount - 1;
        }
    }


    // =================================================
    // EDYCJA
    // =================================================

    private async Task EditAd()
    {
        if (!await RequireAdmin())
        {
            return;
        }


        Navigation.NavigateTo(
            $"/ogloszenie/{Id}/edytuj");
    }


    // =================================================
    // SPRZEDANE
    // =================================================

    private async Task MarkAsSold()
    {
        if (!await RequireAdmin())
        {
            return;
        }


        if (ad == null)
        {
            return;
        }


        bool success;


        if (ad.OlxId.HasValue)
        {
            success =
                await CatalogService.SetOlxAdStatusAsync(
                    ad.Id,
                    AdStatus.Sold);
        }
        else
        {
            success =
                await CatalogService.SetLocalAdStatusAsync(
                    ad.Id,
                    AdStatus.Sold);
        }


        if (success)
        {
            ad.Status =
                AdStatus.Sold;
        }
    }


    // =================================================
    // AKTYWNE
    // =================================================

    private async Task MarkAsActive()
    {
        if (!await RequireAdmin())
        {
            return;
        }


        if (ad == null)
        {
            return;
        }


        bool success;


        if (ad.OlxId.HasValue)
        {
            success =
                await CatalogService.SetOlxAdStatusAsync(
                    ad.Id,
                    AdStatus.Active);
        }
        else
        {
            success =
                await CatalogService.SetLocalAdStatusAsync(
                    ad.Id,
                    AdStatus.Active);
        }


        if (success)
        {
            ad.Status =
                AdStatus.Active;
        }
    }


    // =================================================
    // USUWANIE LOKALNEGO OGŁOSZENIA
    // =================================================

    private async Task DeleteAd()
    {
        if (!await RequireAdmin())
        {
            return;
        }


        if (ad == null)
        {
            return;
        }


        // Dodatkowe zabezpieczenie:
        // ogłoszeń OLX nie usuwamy z tego miejsca.

        if (ad.OlxId.HasValue)
        {
            return;
        }


        var confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                "Czy na pewno chcesz usunąć to lokalne ogłoszenie wraz ze zdjęciami?");


        if (!confirmed)
        {
            return;
        }


        var success =
            await CatalogService.DeleteLocalAdAsync(
                ad.Id);


        if (success)
        {
            Navigation.NavigateTo(
                "/lokalne");
        }
    }


    // =================================================
    // POWRÓT
    // =================================================

    private void GoBack()
    {
        if (ad?.OlxId.HasValue == true)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            Navigation.NavigateTo("/lokalne");
        }
    }

}

