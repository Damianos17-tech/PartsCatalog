@page "/ogloszenie/{Source}/{Id:guid}/edytuj"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using KatalogCzesci.Models
@using KatalogCzesci.Services

@inject CatalogService CatalogService
@inject NavigationManager Navigation

<PageTitle>
    @(ad == null ? "Edycja ogłoszenia" : $"Edytuj: {ad.Title}")
</PageTitle>

<div class="container py-4">

    @if (ad == null)
    {
        <p>Wczytywanie...</p>
    }
    else
    {
        <!-- ================================================= -->
        <!-- NAGŁÓWEK -->
        <!-- ================================================= -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h1>
                    Edytuj ogłoszenie
                </h1>

                <p class="text-muted mb-0">

                    @if (ad.OlxId.HasValue)
                    {
                        <span>
                            Ogłoszenie z OLX
                        </span>
                    }
                    else
                    {
                        <span>
                            Ogłoszenie lokalne / Admin
                        </span>
                    }

                    <span class="mx-2">•</span>

                    ID:
                    @(ad.OlxId?.ToString() ?? ad.Id.ToString("N")[..8])

                </p>

            </div>


            @if (ad.Status == AdStatus.Sold)
            {
                <span class="badge bg-danger fs-6">
                    SPRZEDANE
                </span>
            }

        </div>


        <!-- ================================================= -->
        <!-- DANE OGŁOSZENIA -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <!-- TYTUŁ -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Tytuł
                    </label>

                    <input class="form-control"
                           @bind="ad.Title" />

                </div>


                <!-- OPIS -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Opis
                    </label>

                    <textarea class="form-control"
                              rows="12"
                              @bind="ad.Description">
                        </textarea>

                </div>


                <!-- CENA -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Cena
                    </label>

                    <div class="input-group">

                        <input type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               @bind="ad.Price" />

                        <span class="input-group-text">
                            zł
                        </span>

                    </div>

                </div>


                <!-- GTIN / EAN -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        GTIN / EAN
                    </label>

                    <input class="form-control"
                           @bind="ad.GTIN"
                           placeholder="Np. 5901234123457" />

                    <div class="form-text">
                        Kod GTIN / EAN produktu.
                    </div>

                </div>


                @* <!-- EXTERNAL ID -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        External ID
                    </label>

                    <input class="form-control"
                           @bind="ad.ExternalId"
                           placeholder="Np. CZ-000123" />

                    <div class="form-text">
                        Wewnętrzny identyfikator produktu używany przy eksporcie.
                    </div>

                </div> *@


                <!-- MPN -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        MPN / Numer części
                    </label>

                    <input class="form-control"
                           @bind="ad.MPN"
                           placeholder="Np. 71-38512-00" />

                    <div class="form-text">
                        Numer katalogowy części producenta.
                    </div>

                </div>


                <!-- MARKA -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Marka
                    </label>

                    <input class="form-control"
                           @bind="ad.Brand"
                           placeholder="Np. Victor Reinz" />

                </div>


                <!-- KATEGORIE -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Kategorie
                    </label>

                    @if (ad.OlxId.HasValue)
                    {
                        <input class="form-control"
                               value="@string.Join(" / ", ad.Categories)"
                               disabled />

                        <div class="form-text">
                            Kategorie pochodzą z katalogu OLX.
                        </div>
                    }
                    else
                    {
                        <input class="form-control"
                               @bind="categoriesText"
                               placeholder="Np. Motoryzacja / Części samochodowe" />

                        <div class="form-text">
                            Kategorie lokalnego ogłoszenia. Oddzielaj je znakiem „/”.
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- ZDJĘCIA -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>

                        <h4 class="mb-1">
                            Zdjęcia
                        </h4>

                        <small class="text-muted">
                            @photoFiles.Count zdjęć
                        </small>

                    </div>


                    <label class="btn btn-primary mb-0">

                        ➕ Dodaj zdjęcia

                        <InputFile OnChange="UploadPhotos"
                                   multiple
                                   accept=".jpg,.jpeg"
                                   style="display:none;" />

                    </label>

                </div>


                @if (!string.IsNullOrWhiteSpace(photoMessage))
                {
                    <div class="alert alert-info">
                        @photoMessage
                    </div>
                }


                @if (photoFiles.Count == 0)
                {
                    <div class="alert alert-light border">
                        Brak zdjęć.
                    </div>
                }
                else
                {
                    <div class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-3">

                        @for (var i = 0; i < photoFiles.Count; i++)
                        {
                            var photo = photoFiles[i];

                            <div class="col">

                                <div class="card h-100">

                                    <div class="position-relative bg-light"
                                         style="height: 180px;">

                                        <img src="@GetPhotoPath(photo)"
                                             class="w-100 h-100"
                                             style="object-fit: contain; padding: 8px;"
                                             alt="Zdjęcie @(i + 1)" />

                                        <span class="position-absolute top-0 start-0 badge bg-dark m-2">
                                            @(i + 1)
                                        </span>

                                    </div>

                                    <div class="card-body p-2">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger w-100"
                                                @onclick="() => DeletePhoto(photo)">
                                            🗑 Usuń
                                        </button>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>


        <!-- ================================================= -->
        <!-- PRZYCISKI -->
        <!-- ================================================= -->

        <div class="d-flex gap-2 mb-5">

            <button type="button"
                    class="btn btn-primary"
                    @onclick="Save">

                💾 Zapisz

            </button>


            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="Cancel">

                Anuluj

            </button>

        </div>
    }

</div>


@code {

    [Parameter]
    public string Source { get; set; } = "";

    [Parameter]
    public Guid Id { get; set; }


    private Ad? ad;

    private List<string> photoFiles = [];

    private string categoriesText = "";

    private string? photoMessage;


    // =================================================
    // ODCZYT OGŁOSZENIA
    // =================================================

    protected override async Task OnInitializedAsync()
    {
        Ad? foundAd = null;


        // =================================================
        // OLX
        // =================================================

        if (Source.Equals(
                "olx",
                StringComparison.OrdinalIgnoreCase))
        {
            var olxAds =
                await CatalogService.GetOlxAdsAsync();

            foundAd =
                olxAds.FirstOrDefault(
                    x => x.Id == Id);
        }


        // =================================================
        // LOKALNE
        // =================================================

        else if (Source.Equals(
                     "lokalne",
                     StringComparison.OrdinalIgnoreCase))
        {
            var localAds =
                await CatalogService.GetLocalAdsAsync();

            foundAd =
                localAds.FirstOrDefault(
                    x => x.Id == Id);
        }


        // =================================================
        // NIEZNANE ŹRÓDŁO
        // =================================================

        else
        {
            Navigation.NavigateTo("/");
            return;
        }


        // =================================================
        // BRAK OGŁOSZENIA
        // =================================================

        if (foundAd == null)
        {
            Navigation.NavigateTo("/");
            return;
        }


        // =================================================
        // KOPIA DO FORMULARZA
        // =================================================

        ad = new Ad
        {
            Id =
                foundAd.Id,

            OlxId =
                foundAd.OlxId,

            Title =
                foundAd.Title,

            Description =
                foundAd.Description,

            Price =
                foundAd.Price,

            GTIN =
                foundAd.GTIN,

            ExternalId =
                foundAd.ExternalId,

            MPN =
                foundAd.MPN,

            Brand =
                foundAd.Brand,

            Photos =
                foundAd.Photos?.ToList() ?? [],

            Categories =
                foundAd.Categories?.ToList() ?? [],

            ActivatedAt =
                foundAd.ActivatedAt,

            Status =
                foundAd.Status
        };


        categoriesText =
            string.Join(
                " / ",
                ad.Categories);


        // =================================================
        // PORZĄDKOWANIE ZDJĘĆ
        // =================================================

        photoFiles =
            await CatalogService.NormalizePhotosAsync(
                ad);

        ad.Photos =
            photoFiles.ToList();
    }


    // =================================================
    // ŚCIEŻKA ZDJĘCIA
    // =================================================

    private string GetPhotoPath(
        string fileName)
    {
        if (ad == null)
        {
            return "";
        }


        // Każde ogłoszenie ma własny GUID.
        // Zdjęcia znajdują się w:
        //
        // wwwroot/images/{Ad.Id}/
        //
        // Nie używamy tutaj OlxId.

        return
            $"/images/{ad.Id}/{fileName}";
    }


    // =================================================
    // DODAWANIE ZDJĘĆ
    // =================================================

    private async Task UploadPhotos(
        InputFileChangeEventArgs e)
    {
        if (ad == null)
        {
            return;
        }


        photoMessage = null;


        try
        {
            foreach (var file in e.GetMultipleFiles(20))
            {
                var extension =
                    Path.GetExtension(file.Name)
                        .ToLowerInvariant();


                if (extension != ".jpg" &&
                    extension != ".jpeg")
                {
                    photoMessage =
                        "Na razie obsługiwane są tylko pliki JPG/JPEG.";

                    continue;
                }


                await CatalogService.AddPhotoAsync(
                    ad.Id,
                    file);
            }


            photoFiles =
                await CatalogService.NormalizePhotosAsync(
                    ad);


            ad.Photos =
                photoFiles.ToList();


            photoMessage =
                "Zdjęcia zostały dodane.";
        }
        catch (Exception ex)
        {
            photoMessage =
                $"Nie udało się dodać zdjęć: {ex.Message}";
        }
    }


    // =================================================
    // USUWANIE ZDJĘCIA
    // =================================================

    private async Task DeletePhoto(
        string fileName)
    {
        if (ad == null)
        {
            return;
        }


        var success =
            await CatalogService.DeletePhotoAsync(
                ad.Id,
                fileName);


        if (!success)
        {
            return;
        }


        photoFiles =
            await CatalogService.NormalizePhotosAsync(
                ad);


        ad.Photos =
            photoFiles.ToList();


        photoMessage =
            "Zdjęcie zostało usunięte.";
    }


    // =================================================
    // ZAPIS
    // =================================================

    private async Task Save()
    {
        if (ad == null)
        {
            return;
        }


        // =================================================
        // KATEGORIE LOKALNE
        // =================================================

        if (!ad.OlxId.HasValue)
        {
            ad.Categories =
                categoriesText
                    .Split(
                        '/',
                        StringSplitOptions.RemoveEmptyEntries)
                    .Select(x => x.Trim())
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x))
                    .ToList();
        }


        // =================================================
        // ZDJĘCIA
        // =================================================

        ad.Photos =
            photoFiles.ToList();


        // =================================================
        // ZAPIS DO ODPOWIEDNIEGO PLIKU
        // =================================================

        bool success;


        if (ad.OlxId.HasValue)
        {
            // OLX → ads-from-olx.json

            success =
                await CatalogService.UpdateOlxAdAsync(
                    ad);
        }
        else
        {
            // LOCAL → ads-local.json

            success =
                await CatalogService.UpdateLocalAdAsync(
                    ad);
        }


        // =================================================
        // POWRÓT
        // =================================================

        if (success)
        {
            Navigation.NavigateTo(
                $"/ogloszenie/{Source}/{ad.Id}");
        }
        else
        {
            photoMessage =
                "Nie udało się zapisać zmian.";
        }
    }


    // =================================================
    // ANULOWANIE
    // =================================================

    private void Cancel()
    {
        Navigation.NavigateTo(
            $"/ogloszenie/{Source}/{Id}");
    }

}