
@page "/dodaj"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using KatalogCzesci.Models
@using KatalogCzesci.Services

@inject CatalogService CatalogService
@inject NavigationManager Navigation

<PageTitle>Dodaj ogłoszenie</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Dodaj ogłoszenie</h1>

            <p class="text-muted mb-0">
                Utwórz lokalną pozycję do późniejszego wykorzystania
            </p>
        </div>

    </div>


    <!-- ================================================= -->
    <!-- DANE OGŁOSZENIA -->
    <!-- ================================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <!-- TYTUŁ -->

            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Tytuł
                </label>

                <input class="form-control"
                       @bind="ad.Title"
                       placeholder="Np. Filtr powietrza Knecht..." />

            </div>


            <!-- OPIS -->

            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Opis
                </label>

                <textarea class="form-control"
                          rows="12"
                          @bind="ad.Description"
                          placeholder="Opis części...">
                </textarea>

            </div>


            <!-- CENA -->

            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Cena
                </label>

                <div class="input-group">

                    <input type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           @bind="ad.Price" />

                    <span class="input-group-text">
                        zł
                    </span>

                </div>

            </div>


            <!-- KATEGORIE -->

            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Kategorie
                </label>

                <input class="form-control"
                       @bind="categoriesText"
                       placeholder="Np. Motoryzacja / Części samochodowe" />

                <div class="form-text">
                    Kategorie oddzielaj znakiem „/”.
                </div>

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- ZDJĘCIA -->
    <!-- ================================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>
                    <h4 class="mb-1">
                        Zdjęcia
                    </h4>

                    <small class="text-muted">
                        @photoFiles.Count zdjęć
                    </small>
                </div>

                <label class="btn btn-primary mb-0">

                    ➕ Dodaj zdjęcia

                    <InputFile OnChange="UploadPhotos"
                               multiple
                               accept=".jpg,.jpeg"
                               style="display:none;" />

                </label>

            </div>


            @if (!string.IsNullOrWhiteSpace(photoMessage))
            {
                <div class="alert alert-info">
                    @photoMessage
                </div>
            }


            @if (photoFiles.Count == 0)
            {
                <div class="alert alert-light border">
                    Brak zdjęć.
                </div>
            }
            else
            {
                <div class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-3">

                    @for (var i = 0; i < photoFiles.Count; i++)
                    {
                        var photo = photoFiles[i];

                        <div class="col">

                            <div class="card h-100">

                                <div class="position-relative bg-light"
                                     style="height: 180px;">

                                    <img src="@GetPhotoPath(photo)"
                                         class="w-100 h-100"
                                         style="object-fit: contain; padding: 8px;"
                                         alt="Zdjęcie @(i + 1)" />

                                    <span class="position-absolute top-0 start-0 badge bg-dark m-2">
                                        @(i + 1)
                                    </span>

                                </div>

                                <div class="card-body p-2">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger w-100"
                                            @onclick="() => DeletePhoto(photo)">
                                        🗑 Usuń
                                    </button>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>


    <!-- ================================================= -->
    <!-- PRZYCISKI -->
    <!-- ================================================= -->

    <div class="d-flex gap-2 mb-5">

        <button type="button"
                class="btn btn-primary"
                @onclick="Save">
            💾 Zapisz
        </button>

        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="Cancel">
            Anuluj
        </button>

    </div>

</div>


@code {

    private Ad ad = new();

    private string categoriesText = "";

    private List<string> photoFiles = [];

    private string? photoMessage;

    private bool isPersisted = false;


    // =================================================
    // START
    // =================================================

    protected override Task OnInitializedAsync()
    {
        // Nadajemy ID tylko w pamięci.
        // NIE zapisujemy jeszcze do ads-local.json.
        ad = new Ad
        {
            Id = Guid.NewGuid(),
            OlxId = null,
            Title = "",
            Description = "",
            Price = 0,
            Photos = [],
            Categories = [],
            Status = AdStatus.Active,
            ActivatedAt = DateTime.Now
        };

        return Task.CompletedTask;
    }


    // =================================================
    // ŚCIEŻKA ZDJĘCIA
    // =================================================

    private string GetPhotoPath(
        string fileName)
    {
        return $"/images/{ad.Id}/{fileName}";
    }


    // =================================================
    // DODAWANIE ZDJĘĆ
    // =================================================

    private async Task UploadPhotos(
        InputFileChangeEventArgs e)
    {
        photoMessage = null;

        try
        {
            // Pierwsze dodanie zdjęcia powoduje
            // dopiero utworzenie rekordu w JSON.
            if (!isPersisted)
            {
                ad.Categories =
                    ParseCategories();

                ad.Photos =
                    photoFiles.ToList();

                ad =
                    await CatalogService.CreateLocalAdAsync(
                        ad);

                isPersisted = true;
            }


            foreach (var file in e.GetMultipleFiles(20))
            {
                var extension =
                    Path.GetExtension(file.Name)
                        .ToLowerInvariant();

                if (extension != ".jpg" &&
                    extension != ".jpeg")
                {
                    photoMessage =
                        "Na razie obsługiwane są tylko pliki JPG/JPEG.";

                    continue;
                }


                await CatalogService.AddPhotoAsync(
                    ad.Id,
                    file);
            }


            photoFiles =
                await CatalogService.NormalizePhotosAsync(
                    ad);

            ad.Photos =
                photoFiles.ToList();

            photoMessage =
                "Zdjęcia zostały dodane.";
        }
        catch (Exception ex)
        {
            photoMessage =
                $"Nie udało się dodać zdjęć: {ex.Message}";
        }
    }


    // =================================================
    // USUWANIE ZDJĘCIA
    // =================================================

    private async Task DeletePhoto(
        string fileName)
    {
        if (!isPersisted)
        {
            return;
        }


        var success =
            await CatalogService.DeletePhotoAsync(
                ad.Id,
                fileName);


        if (!success)
        {
            return;
        }


        photoFiles =
            await CatalogService.NormalizePhotosAsync(
                ad);

        ad.Photos =
            photoFiles.ToList();

        photoMessage =
            "Zdjęcie zostało usunięte.";
    }


    // =================================================
    // KATEGORIE
    // =================================================

    private List<string> ParseCategories()
    {
        return categoriesText
            .Split(
                '/',
                StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x =>
                !string.IsNullOrWhiteSpace(x))
            .ToList();
    }


    // =================================================
    // ZAPIS
    // =================================================

    private async Task Save()
    {
        ad.Categories =
            ParseCategories();

        ad.Photos =
            photoFiles.ToList();


        if (!isPersisted)
        {
            // Pierwszy zapis.
            ad =
                await CatalogService.CreateLocalAdAsync(
                    ad);

            isPersisted = true;
        }
        else
        {
            // Kolejne zapisy.
            await CatalogService.UpdateLocalAdAsync(
                ad);
        }


        Navigation.NavigateTo(
            "/lokalne");
    }


    // =================================================
    // ANULOWANIE
    // =================================================

    private async Task Cancel()
    {
        // Jeśli rekord został już zapisany
        // (np. przez dodanie zdjęć), usuwamy go.
        if (isPersisted)
        {
            await CatalogService.DeleteLocalAdAsync(
                ad.Id);
        }

        Navigation.NavigateTo(
            "/lokalne");
    }

}

