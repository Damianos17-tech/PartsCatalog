@page "/lokalne"
@rendermode InteractiveServer

@using KatalogCzesci.Models
@using KatalogCzesci.Services

@implements IAsyncDisposable

@inject CatalogService CatalogService
@inject AdSearchService SearchService
@inject NavigationManager Navigation

<PageTitle>Lokalne / Admin</PageTitle>

<div class="container py-4">

    
    <!-- ================================================= -->
    <!-- NAGŁÓWEK -->
    <!-- ================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="mb-1">
                Ogłoszenia lokalne / Admin
            </h1>

            <p class="text-muted mb-0">
                Lokalne pozycje przygotowywane do późniejszego wykorzystania
            </p>

        </div>


        <div class="d-flex gap-2">

            <!-- ================================================= -->
            <!-- BACKUP -->
            <!-- ================================================= -->

            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="BackupDatabase"
                    disabled="@IsBackupBlocked">

                @if (IsBackupBlocked)
                {
                    <span>
                        💾 Backup (@BackupSecondsRemaining s)
                    </span>
                }
                else
                {
                    <span>
                        💾 Backup
                    </span>
                }

            </button>


            <!-- ================================================= -->
            <!-- DODAJ OGŁOSZENIE -->
            <!-- ================================================= -->

            <button type="button"
                    class="btn btn-primary"
                    @onclick="AddAd"
                    disabled="@IsAddAdBlocked">

                @if (IsAddAdBlocked)
                {
                    <span>
                        + Dodaj ogłoszenie (@AddAdSecondsRemaining s)
                    </span>
                }
                else
                {
                    <span>
                        + Dodaj ogłoszenie
                    </span>
                }

            </button>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- KOMUNIKAT BACKUPU -->
    <!-- ================================================= -->
    @if (!string.IsNullOrWhiteSpace(backupMessage))
    {
        <div class="alert @backupMessageCssClass alert-dismissible fade show mb-4"
             role="alert">

            @backupMessage

            <button type="button"
                    class="btn-close"
                    @onclick="ClearBackupMessage">
            </button>

        </div>
    }


    <!-- ================================================= -->
    <!-- WYSZUKIWARKA -->
    <!-- ================================================= -->
    @if (ads != null)
    {
        <div class="mb-4">

            <div class="input-group input-group-lg">

                <span class="input-group-text bg-white">
                    🔎
                </span>

                <input class="form-control"
                       placeholder="Szukaj części, marki, modelu..."
                       value="@searchQuery"
                       @oninput="OnSearchChanged" />

                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="ClearSearch">

                        ✕

                    </button>
                }

            </div>

        </div>
    }


    <!-- ================================================= -->
    <!-- LISTA -->
    <!-- ================================================= -->
    @if (ads == null)
    {
        <p>Wczytywanie...</p>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">

            <p class="text-muted mb-0">

                @if (string.IsNullOrWhiteSpace(searchQuery))
                {
                    <span>
                        Liczba lokalnych pozycji:
                        <strong>@filteredAds.Count</strong>
                    </span>
                }
                else
                {
                    <span>
                        Znaleziono:
                        <strong>@filteredAds.Count</strong>
                        z @ads.Count
                    </span>
                }

            </p>


            <!-- ================================================= -->
            <!-- SORTOWANIE -->
            <!-- ================================================= -->

            <div style="min-width: 260px;">

                <select class="form-select"
                        value="@sortOption"
                        @onchange="OnSortChanged">

                    <option value="default">
                        Domyślna kolejność
                    </option>

                    <option value="priceAsc">
                        Cena: od najniższej
                    </option>

                    <option value="priceDesc">
                        Cena: od najwyższej
                    </option>

                    <option value="dateDesc">
                        Data: od najnowszych
                    </option>

                    <option value="dateAsc">
                        Data: od najstarszych
                    </option>

                </select>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- BRAK WYNIKÓW -->
        <!-- ================================================= -->
        @if (filteredAds.Count == 0)
        {
            <div class="alert alert-light border">

                @if (string.IsNullOrWhiteSpace(searchQuery))
                {
                    <span>
                        Nie masz jeszcze żadnych lokalnych pozycji.
                    </span>

                    <div class="mt-3">

                        <button type="button"
                                class="btn btn-primary"
                                @onclick="AddAd"
                                disabled="@IsAddAdBlocked">

                            @if (IsAddAdBlocked)
                            {
                                <span>
                                    + Dodaj ogłoszenie (@AddAdSecondsRemaining s)
                                </span>
                            }
                            else
                            {
                                <span>
                                    + Dodaj pierwsze ogłoszenie
                                </span>
                            }

                        </button>

                    </div>
                }
                else
                {
                    <span>
                        Nie znaleziono ogłoszeń dla:
                        <strong>@searchQuery</strong>
                    </span>
                }

            </div>
        }
        else
        {
            <!-- ================================================= -->
            <!-- KARTY OGŁOSZEŃ -->
            <!-- ================================================= -->

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">

                @foreach (var ad in filteredAds)
                {
                    var photoCount =
                    ad.Photos?.Count ?? 0;

                    var currentIndex =
                    currentPhotoIndex.GetValueOrDefault(
                    ad.Id,
                    0);


                    <div class="col">

                        <div class="card h-100 shadow-sm"
                             style="cursor: pointer;"
                             @onclick="() => OpenAd(ad.Id)">


                            <!-- ======================================== -->
                            <!-- ZDJĘCIA -->
                            <!-- ======================================== -->
                            @if (photoCount > 0)
                            {
                                <div class="position-relative bg-white"
                                     style="height: 220px;">

                                    @if (ad.Status == AdStatus.Sold)
                                    {
                                        <span class="badge bg-danger position-absolute top-0 end-0 m-2 shadow-sm"
                                              style="font-size: 0.9rem; z-index: 2;">

                                            SPRZEDANE

                                        </span>
                                    }


                                    <img src="@GetImagePath(ad, currentIndex)"
                                         alt="@ad.Title"
                                         class="w-100 h-100"
                                         style="object-fit: contain; padding: 10px;" />


                                    @if (photoCount > 1)
                                    {
                                        <!-- LEWA STRZAŁKA -->

                                        <button type="button"
                                                class="position-absolute top-50 start-0 translate-middle-y"
                                                style="margin-left: 10px;
                                                                       width: 42px;
                                                                       height: 42px;
                                                                       border: none;
                                                                       border-radius: 6px;
                                                                       background-color: #0d6efd;
                                                                       color: white;
                                                                       font-size: 30px;
                                                                       line-height: 35px;
                                                                       cursor: pointer;
                                                                       box-shadow: 0 2px 6px rgba(0,0,0,0.25);
                                                                       z-index: 3;"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => PreviousPhoto(ad.Id, photoCount)">

                                            ‹

                                        </button>


                                        <!-- PRAWA STRZAŁKA -->

                                        <button type="button"
                                                class="position-absolute top-50 end-0 translate-middle-y"
                                                style="margin-right: 10px;
                                                                       width: 42px;
                                                                       height: 42px;
                                                                       border: none;
                                                                       border-radius: 6px;
                                                                       background-color: #0d6efd;
                                                                       color: white;
                                                                       font-size: 30px;
                                                                       line-height: 35px;
                                                                       cursor: pointer;
                                                                       box-shadow: 0 2px 6px rgba(0,0,0,0.25);
                                                                       z-index: 3;"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => NextPhoto(ad.Id, photoCount)">

                                            ›

                                        </button>


                                        <!-- LICZNIK -->

                                        <div class="position-absolute bottom-0 start-50 translate-middle-x mb-2"
                                             @onclick:stopPropagation="true"
                                             style="z-index: 3;">

                                            <span class="badge bg-dark">
                                                @(currentIndex + 1) / @photoCount
                                            </span>

                                        </div>
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="position-relative d-flex align-items-center justify-content-center bg-light"
                                     style="height: 220px;">

                                    @if (ad.Status == AdStatus.Sold)
                                    {
                                        <span class="badge bg-danger position-absolute top-0 end-0 m-2 shadow-sm">

                                            SPRZEDANE

                                        </span>
                                    }

                                    <span class="text-muted">
                                        Brak zdjęcia
                                    </span>

                                </div>
                            }


                            <!-- ======================================== -->
                            <!-- INFORMACJE -->
                            <!-- ======================================== -->

                            <div class="card-body">

                                <h5 class="card-title">
                                    @ad.Title
                                </h5>


                                @if (ad.Categories?.Any() == true)
                                {
                                    <p class="card-text text-muted mb-2">
                                        @string.Join(" / ", ad.Categories)
                                    </p>
                                }


                                <h4 class="mb-2">
                                    @ad.Price zł
                                </h4>


                                @if (ad.ActivatedAt.HasValue)
                                {
                                    <small class="text-md">

                                        📅 Dodano:
                                        @ad.ActivatedAt.Value
                                        .ToLocalTime()
                                        .ToString("dd.MM.yyyy HH:mm")

                                    </small>
                                }

                            </div>


                            <!-- ======================================== -->
                            <!-- STOPKA -->
                            <!-- ======================================== -->

                            <div class="card-footer bg-white">

                                <small class="text-muted">
                                    ID: @ad.Id.ToString("N")[..8]
                                </small>


                                @if (photoCount > 0)
                                {
                                    <small class="text-muted float-end">
                                        📷 @photoCount
                                    </small>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
    }
    

</div>

@code {


// =================================================
// DANE
// =================================================

private List<Ad>? ads;

    private List<Ad> filteredAds = [];

    private string searchQuery = "";

    private string sortOption = "default";


    // =================================================
    // ZDJĘCIA
    // =================================================

    private readonly Dictionary<Guid, int>
        currentPhotoIndex = new();


    // =================================================
    // BACKUP / DODAWANIE
    // =================================================

    private int BackupSecondsRemaining =>
        CatalogService.GetBackupCooldownSeconds();

    private bool IsBackupBlocked =>
        BackupSecondsRemaining > 0;


    private int AddAdSecondsRemaining =>
        CatalogService.GetCreateAdCooldownSeconds();

    private bool IsAddAdBlocked =>
        AddAdSecondsRemaining > 0;


    // =================================================
    // TIMER UI
    // =================================================

    private PeriodicTimer? _uiTimer;

    private CancellationTokenSource? _timerCancellation;


    // =================================================
    // KOMUNIKAT BACKUPU
    // =================================================

    private string backupMessage = "";

    private string backupMessageCssClass =
        "alert-success";


    // =================================================
    // ODCZYT
    // =================================================

    protected override async Task OnInitializedAsync()
    {
        ads =
            await CatalogService.GetLocalAdsAsync();

        ApplySearch();

        StartUiTimer();
    }


    // =================================================
    // TIMER
    // =================================================

    private void StartUiTimer()
    {
        _timerCancellation =
            new CancellationTokenSource();

        _uiTimer =
            new PeriodicTimer(
                TimeSpan.FromSeconds(1));

        _ = RunUiTimerAsync(
            _timerCancellation.Token);
    }


    private async Task RunUiTimerAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            while (
                _uiTimer != null &&
                await _uiTimer.WaitForNextTickAsync(
                    cancellationToken))
            {
                await InvokeAsync(
                    StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Timer został zatrzymany podczas
            // opuszczania strony.
        }
    }


    // =================================================
    // WYSZUKIWANIE
    // =================================================

    private Task OnSearchChanged(
        ChangeEventArgs e)
    {
        searchQuery =
            e.Value?.ToString() ?? "";

        ApplySearch();

        return InvokeAsync(
            StateHasChanged);
    }


    private Task ClearSearch()
    {
        searchQuery = "";

        ApplySearch();

        return InvokeAsync(
            StateHasChanged);
    }


    // =================================================
    // SORTOWANIE
    // =================================================

    private Task OnSortChanged(
        ChangeEventArgs e)
    {
        sortOption =
            e.Value?.ToString() ?? "default";

        ApplySearch();

        return InvokeAsync(
            StateHasChanged);
    }


    private void ApplySearch()
    {
        if (ads == null)
        {
            filteredAds = [];

            return;
        }


        filteredAds =
            SearchService.Search(
                ads,
                searchQuery);


        filteredAds =
            sortOption switch
            {
                "priceAsc" =>
                    filteredAds
                        .OrderBy(x => x.Price)
                        .ToList(),

                "priceDesc" =>
                    filteredAds
                        .OrderByDescending(x => x.Price)
                        .ToList(),

                "dateDesc" =>
                    filteredAds
                        .OrderByDescending(
                            x => x.ActivatedAt ?? DateTime.MinValue)
                        .ToList(),

                "dateAsc" =>
                    filteredAds
                        .OrderBy(
                            x => x.ActivatedAt ?? DateTime.MaxValue)
                        .ToList(),

                _ =>
                    filteredAds
            };
    }


    // =================================================
    // BACKUP
    // =================================================

    private async Task BackupDatabase()
    {
        backupMessage = "";

        await InvokeAsync(
            StateHasChanged);


        // =================================================
        // SPRAWDZENIE BLOKADY W SERWISIE
        // =================================================

        var cooldown =
            CatalogService.GetBackupCooldownSeconds();


        if (cooldown > 0)
        {
            backupMessage =
                $"⏳ Backup został już wykonany. " +
                $"Możesz wykonać kolejny za " +
                $"{cooldown} sekund.";

            backupMessageCssClass =
                "alert-warning";

            await InvokeAsync(
                StateHasChanged);

            return;
        }


        try
        {
            await CatalogService.BackupDatabaseAsync();

            backupMessage =
                "✅ Backup został wykonany pomyślnie.";

            backupMessageCssClass =
                "alert-success";
        }
        catch (Exception ex)
        {
            backupMessage =
                $"❌ Backup nie powiódł się: {ex.Message}";

            backupMessageCssClass =
                "alert-danger";
        }


        await InvokeAsync(
            StateHasChanged);
    }


    private Task ClearBackupMessage()
    {
        backupMessage = "";

        return InvokeAsync(
            StateHasChanged);
    }


    // =================================================
    // DODAJ OGŁOSZENIE
    // =================================================

    private void AddAd()
    {
        var cooldown =
            CatalogService.GetCreateAdCooldownSeconds();


        if (cooldown > 0)
        {
            return;
        }


        Navigation.NavigateTo(
            "/dodaj");
    }


    // =================================================
    // OTWÓRZ OGŁOSZENIE
    // =================================================

    private void OpenAd(
        Guid adId)
    {
        Navigation.NavigateTo(
            $"/ogloszenie/{adId}");
    }


    // =================================================
    // ZDJĘCIA
    // =================================================

    private string GetImagePath(
        Ad ad,
        int photoIndex)
    {
        return
            $"/images/{ad.Id}/{photoIndex + 1:00}.jpg";
    }


    private void NextPhoto(
        Guid adId,
        int photoCount)
    {
        var currentIndex =
            currentPhotoIndex.GetValueOrDefault(
                adId,
                0);

        currentIndex++;


        if (currentIndex >= photoCount)
        {
            currentIndex = 0;
        }


        currentPhotoIndex[adId] =
            currentIndex;


        StateHasChanged();
    }


    private void PreviousPhoto(
        Guid adId,
        int photoCount)
    {
        var currentIndex =
            currentPhotoIndex.GetValueOrDefault(
                adId,
                0);

        currentIndex--;


        if (currentIndex < 0)
        {
            currentIndex =
                photoCount - 1;
        }


        currentPhotoIndex[adId] =
            currentIndex;


        StateHasChanged();
    }


    // =================================================
    // DISPOSE
    // =================================================

    public async ValueTask DisposeAsync()
    {
        if (_timerCancellation != null)
        {
            await _timerCancellation.CancelAsync();

            _timerCancellation.Dispose();

            _timerCancellation = null;
        }


        _uiTimer?.Dispose();

        _uiTimer = null;
    }


}
