@page "/login"
@rendermode InteractiveServer

@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Logowanie</PageTitle>

<div class="container py-5" style="max-width: 450px;">

    <h2 class="mb-4">Logowanie</h2>

    @if (loginError)
    {
        <div class="text-danger small mb-3">
            Niepoprawny użytkownik lub hasło.
        </div>
    }

    <div class="mb-3">

        <label class="form-label">
            Użytkownik
        </label>

        <input @bind="username"
               class="form-control @(loginError ? "is-invalid" : "")"
               autocomplete="username" />

    </div>

    <div class="mb-3">

        <label class="form-label">
            Hasło
        </label>

        <input type="password"
               @bind="password"
               class="form-control @(loginError ? "is-invalid" : "")"
               autocomplete="current-password" />

    </div>

    <button class="btn btn-primary"
            @onclick="PerformLogin">

        Zaloguj

    </button>

</div>


@code {

    private string username = "";

    private string password = "";

    private bool loginError = false;

    private string returnUrl = "/";


    // =================================================
    // ODCZYT returnUrl
    // =================================================

    protected override void OnInitialized()
    {
        Console.WriteLine(
    $"LOGIN PAGE URI = [{Navigation.Uri}]");

        var uri =
            Navigation.ToAbsoluteUri(
                Navigation.Uri);

        var query =
            Microsoft.AspNetCore.WebUtilities
                .QueryHelpers
                .ParseQuery(uri.Query);


        if (query.TryGetValue("returnUrl", out var value) &&
            !string.IsNullOrWhiteSpace(value))
        {
            returnUrl = value!;

            if (!returnUrl.StartsWith("/"))
            {
                returnUrl = "/" + returnUrl;
            }
        }
    }


    // =================================================
    // LOGOWANIE
    // =================================================

    private async Task PerformLogin()
    {
        loginError = false;


        var result =
            await JS.InvokeAsync<bool>(
                "loginUser",
                username,
                password);


        if (result)
        {
            // -----------------------------------------
            // ZALOGOWANO
            // -----------------------------------------

            Console.WriteLine($"LOGIN OK - RETURN URL = [{returnUrl}]");

            Navigation.NavigateTo(
                returnUrl,
                forceLoad: true);
        }
        else
        {
            loginError = true;
        }
    }

}